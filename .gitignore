# macOS
.DS_Store

# Editors / IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Local environment / secrets (never commit real secrets)
.env
.env.*
!.env.example
*.pem
*.key
!*.example
# Synthetic scanner fixtures: fabricated detection-corpus values, tracked by
# design and validated by `tools/secret_scan.py --self-test`.
!tests/fixtures/secret_scan/positives/*.pem
!tests/fixtures/secret_scan/positives/*.key
secrets/
/secrets.yaml

# Build artifacts
/dist/
/build/
*.tar.gz
*.log

# Local traffic accounting state
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3.lock

# Private operator evidence and deployment helpers (local use only).
# Public examples belong in templates/ or tests/fixtures/ with reserved values.
/operations/
/experiments/
/docs/incidents/
# Per-window operator snapshots are exported as anonymized experiment datasets.
/docs/reports/traffic/
/docs/traffic-audit.md
/docs/wire-traffic-diagnostics.md
/tools/incident/
# These local analysis tests depend on the private incident helper directory.
/tests/test_path_probe_summary.py
/tests/test_quic_trace_summary.py
/tests/test_tcp_info_metrics.py
/tests/test_tcp_sequence_summary.py

# Python bytecode can retain local source paths and literal values.
__pycache__/
*.py[cod]
