[Unit]
Description=Private Proxy IKEv2 fail-closed TPROXY policy
After=network-online.target private-proxy-mihomo.service
Wants=network-online.target
Requires=private-proxy-mihomo.service
Before=private-proxy-ikev2.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/private-proxy/current/deploy/ikev2/configure_policy.py apply
ExecStop=/opt/private-proxy/current/deploy/ikev2/configure_policy.py remove
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
