[Unit]
Description=Private Proxy Hysteria2 exit
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=simple
User=privateproxy
Group=privateproxy
UMask=0077
RuntimeDirectory=private-proxy
RuntimeDirectoryMode=0700
LoadCredential=GATEWAY_EGRESS_PASSWORD_1:/etc/private-proxy/secrets/GATEWAY_EGRESS_PASSWORD_1
LoadCredential=egress.crt:/etc/private-proxy/secrets/egress.crt
LoadCredential=egress.key:/etc/private-proxy/secrets/egress.key
ExecStartPre=/opt/private-proxy/current/proxyctl preflight --role egress --offline --config /etc/private-proxy/egress.yaml
ExecStartPre=/opt/private-proxy/current/proxyctl render --role egress --template-dir /opt/private-proxy/current/templates/hysteria --config /etc/private-proxy/egress.yaml --out-dir /run/private-proxy
ExecStart=/opt/private-proxy/current/hysteria server -c /run/private-proxy/egress-rendered.yaml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/run/private-proxy

[Install]
WantedBy=multi-user.target
