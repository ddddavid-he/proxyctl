[Unit]
Description=Private Proxy total and domain traffic accounting
After=private-proxy-mihomo.service
Wants=private-proxy-mihomo.service

[Service]
Type=simple
User=privateproxy
Group=privateproxy
UMask=0077
StateDirectory=private-proxy-traffic
StateDirectoryMode=0700
ExecStart=/opt/private-proxy/current/proxyctl traffic collect --db /var/lib/private-proxy-traffic/usage.sqlite3 --engine-spool /var/lib/private-proxy-accounting
Restart=on-failure
RestartSec=10s
TimeoutStopSec=10s
MemoryMax=64M
CPUQuota=25%
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/private-proxy-traffic /var/lib/private-proxy-accounting

[Install]
WantedBy=multi-user.target
