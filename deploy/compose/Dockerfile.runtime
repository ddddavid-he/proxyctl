FROM debian@sha256:f324c7ff54321e8d9c588493a20244965938ce0aa50bbd1022d38010e9ffc4b1
# Debian trixie-20260824 multi-architecture OCI index (amd64 and arm64).

ARG STRONGSWAN_VERSION=6.0.1-6+deb13u7
ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates \
       iproute2 \
       nftables \
       python3 \
       charon-systemd=${STRONGSWAN_VERSION} \
       strongswan-swanctl=${STRONGSWAN_VERSION} \
       libcharon-extauth-plugins=${STRONGSWAN_VERSION} \
       libstrongswan-extra-plugins=${STRONGSWAN_VERSION} \
       libstrongswan-standard-plugins=${STRONGSWAN_VERSION} \
    && rm -rf /var/lib/apt/lists/*

STOPSIGNAL SIGTERM
